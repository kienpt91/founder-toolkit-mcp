{
  "name": "founder-toolkit-mcp",
  "version": "0.1.0",
  "description": "Free, no-API-key MCP server and portable agent skills for SEO audits, startup revenue lookups and email authentication checks.",
  "license": "MIT",
  "author": "Kien Phan",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "founder-toolkit-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seo",
    "dmarc",
    "spf",
    "dkim",
    "agent-skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "check:lockfile-age": "node scripts/check-lockfile-age.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
